%include "io64.inc"
section .data
    s_data: dq 0x123456789ABCDEF0  
    c_data: db 6553                   
                               
section .text
extern access6
global main

main:
    push rbp
    mov rbp, rsp
    sub rsp, 32
    lea rcx, [c_data]      
    lea rdx, [s_data]   
    
    call access6
    
    add rsp, 32
    pop rbp
    ret